{
  "name": "zuhaitz",
  "version": "0.7.1",
  "description": "Offline PWA to identify Spanish trees via an adaptive trait key",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && npm run type:check && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,css,json}\" \"*.{ts,js}\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,css,json}\" \"*.{ts,js}\"",
    "type:check": "tsc --noEmit",
    "validate": "tsx scripts/validate-dataset.ts",
    "photos": "tsx scripts/fetch-photos.ts",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
