{
  "name": "zuhaitz",
  "version": "0.5.4",
  "description": "Offline PWA to identify Spanish trees via an adaptive trait key",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && npm run type:check && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,css,json}\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,css,json}\"",
    "type:check": "tsc --noEmit",
    "validate": "tsx scripts/validate-dataset.ts",
    "photos": "tsx scripts/fetch-photos.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
